# Example environment for Adaptive Crypto Trading System.
# The code reads OS environment variables directly (no .env loader).
# Copy the names you need into your shell session; never commit real values.

# Required to run the local read-only dashboard:
DASHBOARD_PASSWORD=change-me-locally

# Optional: read-only Binance USD-M account snapshot for the dashboard's
# "REAL ACCOUNT — READ ONLY" mode. Use a key restricted to account READ
# permissions only — never a key with trade/withdraw/leverage permissions.
# Leave both empty to keep the dashboard disconnected (its default state).
DASHBOARD_BINANCE_READONLY_KEY=
DASHBOARD_BINANCE_READONLY_SECRET=
